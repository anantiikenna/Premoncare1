{
  "name": "premoncare-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "lint:web": "npm run lint --workspace=apps/web",
    "test:web": "npm run test --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "format:web": "npm run format --workspace=apps/web",
    "analyze:mobile": "cd apps/mobile && flutter analyze",
    "test:mobile": "cd apps/mobile && flutter test",
    "lint": "npm run lint:web",
    "test": "npm run test:web",
    "typecheck": "npm run typecheck:web",
    "format": "npm run format:web"
  },
  "devDependencies": {
    "metro": "^0.80.3",
    "metro-resolver": "^0.80.3"
  }
}
