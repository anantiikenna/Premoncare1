# Supabase Configuration
# You can find these in your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Configuration
# The base URL of your application (e.g., http://localhost:3000 in development)
NEXT_PUBLIC_SITE_URL=https://premoncare.netlify.app

# Security & API Configurations
ALLOWED_CORS_ORIGINS=http://localhost:3000,capacitor://localhost,https://premoncare.netlify.app
# If implementing global rate limiting
# UPSTASH_REDIS_REST_URL=your-upstash-redis-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Analytics Configuration (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Dodo Payments Configuration (DISABLED — manual P2P receipt verification active)
# DODO_WEBHOOK_SECRET=your-dodo-webhook-secret

# Paystack Configuration (DISABLED — manual P2P receipt verification active)
# PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Storage Buckets (Must be created manually in Supabase UI)
# 1. avatars (Public)
# 2. doctor-verifications (Private) 
# 3. doctor-identities (Private)
# 4. payment-receipts (Private)
# 5. health-records (Private)
# 6. patient-verifications (Private)

# Database Setup
# Run the contents of supabase/schema.sql in the Supabase SQL Editor to:
# - Create the required tables (profiles, appointments, records, forum, etc.)
# - Set up Row Level Security (RLS) policies
# - Enable triggers for automatic profile creation

# Email Notifications (Loops.so)
# We use Loops for transactional emails (appointment confirmations, payment receipts)
LOOPS_API_KEY=your-loops-api-key
