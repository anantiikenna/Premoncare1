# Supabase Configuration
# You can find these in your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Configuration
# The base URL of your application (e.g., http://localhost:3000 in development)
NEXT_PUBLIC_SITE_URL=https://premoncare.netlify.app

# Android APK download (served from the public sidecar repo's GitHub Releases)
# Publish a new build from the sidecar clone: C:\Users\Ikenna\Codesss\premoncare-releases
#   .\scripts\release-apk.ps1 -Apk <path-to-apk> -Version vX.Y.Z
# Only the stable /releases/latest/download/ URL lives here - never the APK itself.
# Version/size/SHA-256 metadata lives in src/lib/android-download.ts (update each release).
# NEXT_PUBLIC_* is inlined at build time - set the same value on your deploy host.
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/anantiikenna/premoncare-releases/releases/latest/download/app-user-release.apk

# Firebase Admin SDK (FCM Push Notifications)
# Download the service account key from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Loops Email Service (Transactional Emails)
# Get your API key from https://loops.so > Settings > API
LOOPS_API_KEY=your-loops-api-key
LOOPS_DEFAULT_TRANSACTIONAL_ID=your-transactional-email-template-id

# Email Notifications (SMTP) — fallback if Loops is not configured
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME='Premon Care'
SMTP_FROM_EMAIL=no-reply@premoncare.com

# Storage Buckets (Must be created manually in Supabase UI)
# 1. avatars (Public)
# 2. doctor-verifications (Private)
# 3. doctor-identities (Private)
# 4. payment-receipts (Private)
# 5. health-records (Private)
# 6. patient-verifications (Private)

# Database Setup
# Run the contents of supabase/schema.sql in the Supabase SQL Editor to:
# - Create the required tables (profiles, appointments, records, forum, etc.)
# - Set up Row Level Security (RLS) policies
# - Enable triggers for automatic profile creation

# Payment Gateways (DISABLED — manual P2P receipt verification active)
# DODO_CHECKOUT_ID=your-dodo-checkout-id
# DODO_SECRET_KEY=your-dodo-secret-key
# PAYSTACK_SECRET_KEY=your-paystack-secret-key
